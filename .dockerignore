# Evita enviar arquivos desnecessarios para o contexto de build das imagens.
node_modules
**/node_modules

# Saidas de build (geradas dentro da imagem)
dist
build
**/dist
**/build
# IMPORTANTE: "*.tsbuildinfo" so casa a raiz (no .dockerignore o * nao cruza /).
# Os buildinfo aninhados (ex.: packages/contracts/tsconfig.tsbuildinfo) precisam
# de "**/" senao sao copiados para o contexto. Como o dist aninhado e excluido
# acima, um buildinfo obsoleto faria o tsc (composite/incremental) achar que esta
# tudo atualizado e NAO emitir o dist/index.d.ts — quebrando o build da API com
# "Cannot find module '@dcmg/contracts'".
*.tsbuildinfo
**/*.tsbuildinfo

# Variaveis de ambiente e segredos
.env
.env.local

# Git e metadados
.git
.gitignore
.gitattributes

# Logs e cobertura
*.log
coverage
**/coverage

# Documentacao e infra que nao entram na imagem
README.md
**/*.md
infra/nginx/certs

# Sistema operacional / editores
.DS_Store
Thumbs.db
.idea
.vscode
