# ============================================================================
# Plataforma Defesa Civil MG — variaveis de ambiente (EXEMPLO)
# Copie este arquivo para `.env` e ajuste os valores. NUNCA versione o `.env`.
# Os segredos abaixo sao FAKE; troque-os em qualquer ambiente real.
# ============================================================================

# ----------------------------------------------------------------------------
# Aplicacao
# ----------------------------------------------------------------------------
# Ambiente de execucao do Node (development | production | test)
NODE_ENV=development
# Rotulo de ambiente da plataforma (development | staging | production)
APP_ENV=development
# Porta interna em que a API NestJS escuta dentro do container
PORT=4000
# Prefixo global das rotas HTTP da API (setGlobalPrefix)
API_PREFIX=api
# Origens permitidas para CORS, separadas por virgula (csv)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
# URL publica base por onde a plataforma e acessada (usada em links/redirects)
PUBLIC_BASE_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# DEV (API local): localhost:5436  |  Docker full-stack: postgres:5432
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://dcmg:dcmg@localhost:5436/defesa_civil_mg?schema=public
POSTGRES_USER=dcmg
POSTGRES_PASSWORD=dcmg
POSTGRES_DB=defesa_civil_mg

# ----------------------------------------------------------------------------
# Cache / filas (Redis)
# DEV (API local): localhost:6379  |  Docker full-stack: redis:6379
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Em producao, defina uma senha forte e use: redis://:SENHA@redis:6379
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# Autenticacao (JWT)
# Troque os segredos por valores longos e aleatorios em producao.
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=troque-este-segredo-de-access
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# ----------------------------------------------------------------------------
# Armazenamento de arquivos
# - driver `local`: grava em disco (dev). Anexos pequenos via servidor.
# - driver `s3`: S3-compatível. Para anexos GRANDES (até 50 GB), o navegador
#   envia direto ao bucket via multipart presigned (não passa pelo servidor).
#
# Cloudflare R2 (recomendado em produção):
#   STORAGE_DRIVER=s3
#   S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=<bucket>
#   S3_ACCESS_KEY=<r2_access_key>
#   S3_SECRET_KEY=<r2_secret_key>
#   S3_FORCE_PATH_STYLE=true
#
# IMPORTANTE: configure o CORS do bucket R2 permitindo a origem da app
# (localhost:3000 + URL do ngrok), métodos PUT/GET/HEAD e ExposeHeaders: ETag
# (o ETag é obrigatório para o upload multipart funcionar).
# ----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=

# ----------------------------------------------------------------------------
# Limites e infraestrutura de runtime
# ----------------------------------------------------------------------------
# Tamanho maximo de upload de anexos, em megabytes (51200 = 50 GB)
MAX_UPLOAD_MB=51200
# Habilita o adapter Redis para o WebSocket (escala horizontal do Socket.IO)
WS_REDIS_ADAPTER=true
# Rate limiting: janela em segundos e numero maximo de requisicoes por janela
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# ----------------------------------------------------------------------------
# Notificacoes por e-mail (SMTP) — deixar em branco para desabilitar
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Defesa Civil MG" <noreply@defesacivil.mg.gov.br>
# Nivel de log (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Web / Nginx
# Porta do HOST publicada para a SPA (mapeada para a porta 8080 do container web)
# ----------------------------------------------------------------------------
NGINX_HTTP_PORT=8080
# Obs.: API_BASE_URL e SOCKET_PATH NAO ficam aqui. Sao injetados pelo
# docker-compose no servico web e gravados no /env.js pelo entrypoint (sempre
# relativos: /api e /socket.io), por design "build once, deploy anywhere".

# ----------------------------------------------------------------------------
# Ngrok — túnel público automático
# O start-dev.ps1 usa este token para abrir um túnel para a SPA (web:8080) e
# exibir a URL pública. Se ficar como o placeholder abaixo, o túnel é pulado
# (a stack sobe normalmente em http://localhost:8080). Use .\start-dev.ps1
# -NoTunnel para subir sem o túnel mesmo com token configurado.
# Obtenha o token em https://dashboard.ngrok.com
# ----------------------------------------------------------------------------
NGROK_AUTHTOKEN=troque-este-token-do-ngrok
# Porta do HOST onde o inspector/UI do ngrok é publicado (padrão 4040).
# Troque por uma porta alta (ex.: 45040) se a 4040 conflitar com outro serviço.
NGROK_INSPECTOR_PORT=4040
