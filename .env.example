# ============================================================================
# Plataforma Defesa Civil MG — variaveis de ambiente (EXEMPLO)
# Copie este arquivo para `.env` e ajuste os valores. NUNCA versione o `.env`.
# Os segredos abaixo sao FAKE; troque-os em qualquer ambiente real.
# ============================================================================

# ----------------------------------------------------------------------------
# Aplicacao
# ----------------------------------------------------------------------------
# Ambiente de execucao do Node (development | production | test)
NODE_ENV=development
# Rotulo de ambiente da plataforma (development | staging | production)
APP_ENV=development
# Porta interna em que a API NestJS escuta dentro do container
PORT=4000
# Prefixo global das rotas HTTP da API (setGlobalPrefix)
API_PREFIX=api
# Origens permitidas para CORS, separadas por virgula (csv)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
# URL publica base por onde a plataforma e acessada (usada em links/redirects)
PUBLIC_BASE_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# DEV: PostgreSQL local (docker-compose) em localhost:5436.
# PROD: Azure Database for PostgreSQL (Flexible Server), gerenciado e FORA da VM:
#   DATABASE_URL=postgresql://USUARIO:SENHA@SERVIDOR.postgres.database.azure.com:5432/defesacivil?sslmode=require
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://dcmg:dcmg@localhost:5436/defesa_civil_mg?schema=public
# POSTGRES_* só são usados pelo PostgreSQL local em DEV (docker-compose).
POSTGRES_USER=dcmg
POSTGRES_PASSWORD=dcmg
POSTGRES_DB=defesa_civil_mg

# ----------------------------------------------------------------------------
# Autenticacao (JWT)
# Troque os segredos por valores longos e aleatorios em producao.
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=troque-este-segredo-de-access
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# ----------------------------------------------------------------------------
# Armazenamento de arquivos
# - driver `local`: grava em disco (dev/local).
# - driver `azure`: Azure Blob Storage. Upload de anexos vai DIRETO do navegador
#   ao Blob via SAS (não passa pelo servidor). Configure o CORS do container no
#   Azure (PUT/GET, header x-ms-blob-type, origem da app).
# ----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=anexos

# ----------------------------------------------------------------------------
# Limites e infraestrutura de runtime
# ----------------------------------------------------------------------------
# Tamanho maximo de upload de anexos, em megabytes
MAX_UPLOAD_MB=50
# Rate limiting: janela em segundos e numero maximo de requisicoes por janela
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# ----------------------------------------------------------------------------
# Notificacoes por e-mail (SMTP) — deixar em branco para desabilitar
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Defesa Civil MG" <noreply@defesacivil.mg.gov.br>
# Nivel de log (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Web / Nginx
# Porta do HOST publicada para a SPA (mapeada para a porta 8080 do container web)
# ----------------------------------------------------------------------------
NGINX_HTTP_PORT=8080
# Obs.: API_BASE_URL NAO fica aqui. E injetado pelo docker-compose no servico
# web e gravado no /env.js pelo entrypoint (sempre relativo: /api), por design
# "build once, deploy anywhere".
