# =============================================================================
# Exemplo de variáveis de ambiente da API (Defesa Civil MG).
# Copie para `.env` e preencha com valores reais. NÃO comite o `.env`.
# Os nomes batem EXATAMENTE com src/config/env.validation.ts (validação Zod).
# =============================================================================

# --- Aplicação ---
NODE_ENV=development                 # development | test | production
APP_ENV=development
PORT=4000
API_PREFIX=api
# Lista CSV de origens permitidas no CORS. OBRIGATÓRIA em produção (sem ela o
# boot falha). Ex.: https://app.defesacivil.mg.gov.br
CORS_ORIGINS=
# URL pública base (usada nos links de e-mail). Ex.: https://app.defesacivil.mg.gov.br
PUBLIC_BASE_URL=

# --- Banco de dados (PostgreSQL) ---
# DEV: PostgreSQL local (docker-compose) em localhost:5436.
# PROD: Azure Database for PostgreSQL (Flexible Server) — exige sslmode=require.
# Recomendado limitar o pool numa B2 com DB remoto: &connection_limit=5&pool_timeout=20
#   postgresql://USUARIO:SENHA@SERVIDOR.postgres.database.azure.com:5432/defesacivil?sslmode=require&connection_limit=5&pool_timeout=20
DATABASE_URL=postgresql://dcmg:dcmg@localhost:5436/defesa_civil_mg?schema=public
# POSTGRES_* são usados apenas pelo PostgreSQL local em DEV (docker-compose).
# Em produção (banco gerenciado Azure) podem ficar com qualquer placeholder.
POSTGRES_USER=dcmg
POSTGRES_PASSWORD=dcmg
POSTGRES_DB=defesa_civil_mg

# --- JWT (segredos fortes e DISTINTOS; mín. 32 caracteres em produção) ---
JWT_ACCESS_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres
JWT_REFRESH_SECRET=gere-OUTRO-segredo-aleatorio-distinto-do-access-32+
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# --- Armazenamento de arquivos ---
# - driver `local`: grava em disco (dev/local).
# - driver `azure`: Azure Blob Storage. O upload de anexos vai DIRETO do
#   navegador ao Blob via SAS (não passa pelo servidor). Configure o CORS do
#   container no Azure (PUT/GET, header x-ms-blob-type, origem da app).
STORAGE_DRIVER=local                 # local | azure
STORAGE_LOCAL_PATH=/data/uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=anexos

# --- Limites e infraestrutura ---
MAX_UPLOAD_MB=50
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
LOG_LEVEL=info                       # fatal|error|warn|info|debug|trace
NGINX_HTTP_PORT=8080

# --- SMTP (opcional — notificações e recuperação de senha por e-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Defesa Civil MG" <noreply@defesacivil.mg.gov.br>
