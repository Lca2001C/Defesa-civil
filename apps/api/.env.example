# =============================================================================
# Exemplo de variáveis de ambiente da API (Defesa Civil MG).
# Copie para `.env` e preencha com valores reais. NÃO comite o `.env`.
# Os nomes batem EXATAMENTE com src/config/env.validation.ts (validação Zod).
# =============================================================================

# --- Aplicação ---
NODE_ENV=development                 # development | test | production
APP_ENV=development
PORT=4000
API_PREFIX=api
# Lista CSV de origens permitidas no CORS. OBRIGATÓRIA em produção (sem ela o
# boot falha). Ex.: https://app.defesacivil.mg.gov.br,https://admin.exemplo.gov.br
CORS_ORIGINS=
# URL pública base (usada nos links de e-mail). Ex.: https://app.defesacivil.mg.gov.br
PUBLIC_BASE_URL=

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public
POSTGRES_USER=trocar
POSTGRES_PASSWORD=trocar
POSTGRES_DB=defesacivil

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT (segredos fortes e DISTINTOS; mín. 32 caracteres em produção) ---
JWT_ACCESS_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres
JWT_REFRESH_SECRET=gere-OUTRO-segredo-aleatorio-distinto-do-access-32+
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# --- Armazenamento de arquivos ---
STORAGE_DRIVER=local                 # local | s3
STORAGE_LOCAL_PATH=/data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# --- Limites e infraestrutura ---
MAX_UPLOAD_MB=51200                  # 50 GB
WS_REDIS_ADAPTER=true
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
LOG_LEVEL=info                       # fatal|error|warn|info|debug|trace
NGINX_HTTP_PORT=8080

# --- SMTP (opcional — recuperação de senha por e-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Defesa Civil MG" <noreply@defesacivil.mg.gov.br>
