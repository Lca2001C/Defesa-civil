// =============================================================================
// Schema Prisma — Plataforma Defesa Civil MG (Passo 2: Nucleo de dados)
// -----------------------------------------------------------------------------
// Modela as entidades da secao 8 da arquitetura:
//  - Territorio (UF / Regional-REDEC / Municipio-IBGE / COMPDEC)
//  - RBAC (Perfil / Permissao / Usuario com escopo multi-tenant)
//  - Competencia (periodo de coleta) — vinculo obrigatorio em form/submissao
//  - Motor de formularios (Formulario / FormularioVersao com schema JSONB)
//  - Submissao (snapshot do respondente + protocolo + dados JSONB) e revisao
//  - Importacao em massa (lote + erros) e geracao atomica de protocolo
//  - Arquivo (storage) e LogAuditoria
//
// Convencoes: campos em camelCase no Prisma; colunas/tabelas em snake_case
// (@map/@@map); datas em created_at/updated_at; JSON -> jsonb no Postgres.
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================ ENUMS ==========================================

/// Escopo de acesso do usuario (multi-tenant hierarquico).
enum EscopoUsuario {
  ESTADUAL
  REGIONAL
  MUNICIPAL
}

/// Ciclo de vida de uma competencia (periodo de coleta).
enum CompetenciaStatus {
  PLANEJADA
  ABERTA
  ENCERRADA
}

/// Situacao de um formulario e de suas versoes.
enum FormularioStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

/// Situacao de uma submissao (resposta de um municipio). Workflow de 6 estados.
enum SubmissaoStatus {
  RASCUNHO
  EM_PREENCHIMENTO
  ENVIADO
  CORRECAO_SOLICITADA
  REVISADO
  APROVADO
}

/// Tipos de pergunta suportados pelo construtor visual de formularios.
enum TipoPergunta {
  TEXTO_CURTO
  TEXTO_LONGO
  NUMERO
  DATA
  EMAIL
  TELEFONE
  CPF
  CNPJ
  CEP
  MOEDA
  PORCENTAGEM
  SIM_NAO
  LISTA_SUSPENSA
  RADIO
  CHECKBOX
  UPLOAD
  URL
  AUTOMATICO
}

/// Fonte de preenchimento de uma pergunta AUTOMATICO (resolvida no servidor).
enum FonteAutomatica {
  CODIGO_IBGE
  MUNICIPIO_ATUAL
  USUARIO_ATUAL
  DATA_ATUAL
  ANO_ATUAL
  COMPETENCIA_ATUAL
  PROTOCOLO
}

/// Operador de comparacao de uma regra condicional.
enum OperadorCondicional {
  IGUAL
  DIFERENTE
}

/// Acao de uma regra condicional sobre a pergunta-alvo (quando a condicao e satisfeita).
enum AcaoCondicional {
  MOSTRAR
  OCULTAR
}

// ========================= TERRITORIO ========================================

/// Unidade Federativa. `id` = codigo IBGE de 2 digitos (ex.: 31 = MG).
model Uf {
  id           Int      @id
  sigla        String   @unique
  nome         String
  criadoEm     DateTime @default(now()) @map("created_at")
  atualizadoEm DateTime @updatedAt @map("updated_at")

  municipios Municipio[]
  regionais  Regional[]
  usuarios   Usuario[]

  @@map("ufs")
}

/// Regional de Defesa Civil (REDEC). Mapeamento municipio->REDEC e
/// populado pela CEDEC (nao vem do IBGE); por isso a FK em Municipio e opcional.
model Regional {
  id           String   @id @default(cuid())
  nome         String
  sigla        String?
  ufId         Int      @map("uf_id")
  criadoEm     DateTime @default(now()) @map("created_at")
  atualizadoEm DateTime @updatedAt @map("updated_at")

  uf         Uf          @relation(fields: [ufId], references: [id])
  municipios Municipio[]
  usuarios   Usuario[]

  @@unique([ufId, nome])
  @@index([ufId])
  @@map("regionais")
}

/// Municipio. `id` = codigo IBGE de 7 digitos (ex.: 3106200 = Belo Horizonte).
model Municipio {
  id           Int      @id
  nome         String
  ufId         Int      @map("uf_id")
  regionalId   String?  @map("regional_id")
  criadoEm     DateTime @default(now()) @map("created_at")
  atualizadoEm DateTime @updatedAt @map("updated_at")

  uf         Uf          @relation(fields: [ufId], references: [id])
  regional   Regional?   @relation(fields: [regionalId], references: [id])
  compdec    Compdec?
  usuarios   Usuario[]
  submissoes Submissao[]

  @@index([ufId])
  @@index([regionalId])
  @@index([nome])
  @@map("municipios")
}

/// Coordenadoria Municipal de Protecao e Defesa Civil (1:1 com Municipio).
/// Alimenta o drawer do Painel Estadual (coordenador/telefone/email).
model Compdec {
  id              String   @id @default(cuid())
  municipioId     Int      @unique @map("municipio_id")
  coordenadorNome String?  @map("coordenador_nome")
  telefone        String?
  email           String?
  criadoEm        DateTime @default(now()) @map("created_at")
  atualizadoEm    DateTime @updatedAt @map("updated_at")

  municipio Municipio @relation(fields: [municipioId], references: [id])

  @@map("compdecs")
}

// ========================= RBAC / USUARIOS ===================================

/// Perfil de acesso (papel). `codigo` casa com PerfilUsuario de @dcmg/contracts.
model Perfil {
  id           String   @id @default(cuid())
  codigo       String   @unique
  nome         String
  nivel        Int
  criadoEm     DateTime @default(now()) @map("created_at")
  atualizadoEm DateTime @updatedAt @map("updated_at")

  permissoes Permissao[] @relation("PerfilPermissoes")
  usuarios   Usuario[]

  @@map("perfis")
}

/// Permissao granular no formato "modulo.acao" (ex.: formularios.publicar).
model Permissao {
  id        String   @id @default(cuid())
  chave     String   @unique
  descricao String?
  criadoEm  DateTime @default(now()) @map("created_at")

  perfis Perfil[] @relation("PerfilPermissoes")

  @@map("permissoes")
}

/// Usuario (agente das COMPDECs/CEDEC). Escopo define o alcance multi-tenant.
model Usuario {
  id             String        @id @default(cuid())
  nome           String
  cpf            String        @unique
  email          String        @unique
  senhaHash      String        @map("senha_hash")
  cargo          String?
  telefone       String?
  perfilId       String        @map("perfil_id")
  escopo         EscopoUsuario
  ufId           Int?          @map("uf_id")
  regionalId     String?       @map("regional_id")
  municipioId    Int?          @map("municipio_id")
  ativo          Boolean       @default(true)
  ultimoAcessoEm DateTime?     @map("ultimo_acesso_em")
  criadoEm       DateTime      @default(now()) @map("created_at")
  atualizadoEm   DateTime      @updatedAt @map("updated_at")

  perfil      Perfil             @relation(fields: [perfilId], references: [id])
  uf          Uf?                @relation(fields: [ufId], references: [id])
  regional    Regional?          @relation(fields: [regionalId], references: [id])
  municipio   Municipio?         @relation(fields: [municipioId], references: [id])
  mfaSecret  String?  @map("mfa_secret")
  mfaAtivo   Boolean  @default(false) @map("mfa_ativo")

  submissoes Submissao[]
  historico  RespostaHistorico[]
  logs       LogAuditoria[]
  aceites    AceiteTermoLgpd[]

  @@index([perfilId])
  @@index([municipioId])
  @@index([regionalId])
  @@map("usuarios")
}

// ========================= COMPETENCIA =======================================

/// Periodo de coleta. Todo FormularioVersao publicado e toda Submissao
/// sao vinculados a uma Competencia; o Painel filtra por competencia.
model Competencia {
  id           String            @id @default(cuid())
  nome         String
  ano          Int
  dataInicio   DateTime          @map("data_inicio")
  dataFim      DateTime          @map("data_fim")
  status       CompetenciaStatus @default(PLANEJADA)
  criadoEm     DateTime          @default(now()) @map("created_at")
  atualizadoEm DateTime          @updatedAt @map("updated_at")

  formularioVersoes FormularioVersao[]
  submissoes        Submissao[]

  @@index([ano])
  @@index([status])
  @@map("competencias")
}

// ===================== MOTOR DE FORMULARIOS ==================================

/// Formulario dinamico (metadados). O schema dos campos fica na versao.
model Formulario {
  id           String           @id @default(cuid())
  nome         String
  descricao    String?
  categoria    String?
  status       FormularioStatus @default(RASCUNHO)
  criadoEm     DateTime         @default(now()) @map("created_at")
  atualizadoEm DateTime         @updatedAt @map("updated_at")

  versoes FormularioVersao[]

  @@map("formularios")
}

/// Versao imutavel de um formulario. A estrutura (secoes/perguntas/opcoes/regras)
/// e NORMALIZADA em tabelas filhas. `competenciaId` e obrigatorio na publicacao.
model FormularioVersao {
  id            String           @id @default(cuid())
  formularioId  String           @map("formulario_id")
  versao        Int
  competenciaId String?          @map("competencia_id")
  status        FormularioStatus @default(RASCUNHO)
  publicadoEm   DateTime?        @map("publicado_em")
  criadoEm      DateTime         @default(now()) @map("created_at")
  atualizadoEm  DateTime         @updatedAt @map("updated_at")

  formulario  Formulario   @relation(fields: [formularioId], references: [id])
  competencia Competencia? @relation(fields: [competenciaId], references: [id])
  secoes      Secao[]
  submissoes  Submissao[]

  @@unique([formularioId, versao])
  @@index([competenciaId])
  @@map("formulario_versoes")
}

/// Secao (agrupamento de perguntas) de uma versao de formulario.
model Secao {
  id        String  @id @default(cuid())
  versaoId  String  @map("versao_id")
  ordem     Int
  titulo    String
  descricao String?

  versao    FormularioVersao @relation(fields: [versaoId], references: [id], onDelete: Cascade)
  perguntas Pergunta[]

  @@index([versaoId])
  @@map("secoes")
}

/// Pergunta (campo) de uma secao. `codigo` e a chave estavel usada nas respostas.
model Pergunta {
  id              String           @id @default(cuid())
  secaoId         String           @map("secao_id")
  ordem           Int
  codigo          String
  rotulo          String
  tipo            TipoPergunta
  obrigatorio     Boolean          @default(false)
  ajuda           String?
  // Validacoes (usadas conforme o tipo)
  min             Int?
  max             Int?
  padrao          String?
  tamanhoMaximoMb Int?             @map("tamanho_maximo_mb")
  tiposArquivo    String[]         @map("tipos_arquivo")
  // Para tipo AUTOMATICO
  fonteAutomatica FonteAutomatica? @map("fonte_automatica")

  secao            Secao              @relation(fields: [secaoId], references: [id], onDelete: Cascade)
  opcoes           OpcaoPergunta[]
  regrasComoAlvo   RegraCondicional[] @relation("RegraAlvo")
  regrasComoOrigem RegraCondicional[] @relation("RegraOrigem")
  respostas        Resposta[]

  @@index([secaoId])
  @@map("perguntas")
}

/// Opcao de uma pergunta dos tipos LISTA_SUSPENSA, RADIO ou CHECKBOX.
model OpcaoPergunta {
  id         String @id @default(cuid())
  perguntaId String @map("pergunta_id")
  ordem      Int
  valor      String
  rotulo     String

  pergunta Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)

  @@index([perguntaId])
  @@map("opcoes_pergunta")
}

/// Regra condicional: quando a pergunta de origem satisfaz (operador, valor),
/// aplica a acao (MOSTRAR/OCULTAR) sobre a pergunta-alvo.
model RegraCondicional {
  id               String              @id @default(cuid())
  perguntaAlvoId   String              @map("pergunta_alvo_id")
  perguntaOrigemId String              @map("pergunta_origem_id")
  operador         OperadorCondicional @default(IGUAL)
  valor            String
  acao             AcaoCondicional     @default(MOSTRAR)

  alvo   Pergunta @relation("RegraAlvo", fields: [perguntaAlvoId], references: [id], onDelete: Cascade)
  origem Pergunta @relation("RegraOrigem", fields: [perguntaOrigemId], references: [id], onDelete: Cascade)

  @@index([perguntaAlvoId])
  @@index([perguntaOrigemId])
  @@map("regras_condicionais")
}

/// Template de FORMULARIO INTEIRO (biblioteca). `schema` em JSON (SchemaFormulario).
model FormularioTemplate {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  categoria String?
  schema    Json
  criadoEm  DateTime @default(now()) @map("created_at")

  @@map("formulario_templates")
}

/// Bloco reutilizavel (grupo de perguntas) inserido pelo construtor numa secao.
/// `conteudo` em JSON no formato de uma secao parcial (perguntas/opcoes/regras).
model BlocoReutilizavel {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  categoria String?
  conteudo  Json
  criadoEm  DateTime @default(now()) @map("created_at")

  @@map("blocos_reutilizaveis")
}

// ========================= SUBMISSOES ========================================

/// Resposta de um municipio. Grava um SNAPSHOT imutavel do respondente
/// (nome/CPF/cargo/contato/IP/user-agent) alem da FK do autor, e um protocolo
/// unico (MG-AAAA-NNNNNNNN). `dados` (JSONB) sao as respostas do schema.
model Submissao {
  id                  String          @id @default(cuid())
  protocolo           String          @unique
  municipioId         Int             @map("municipio_id")
  formularioVersaoId  String          @map("formulario_versao_id")
  competenciaId       String          @map("competencia_id")
  autorId             String          @map("autor_id")
  nomeRespondente     String          @map("nome_respondente")
  cpfRespondente      String          @map("cpf_respondente")
  cargoRespondente    String?         @map("cargo_respondente")
  emailRespondente    String?         @map("email_respondente")
  telefoneRespondente String?         @map("telefone_respondente")
  ipResposta          String?         @map("ip_resposta")
  userAgent           String?         @map("user_agent")
  status              SubmissaoStatus @default(RASCUNHO)
  enviadoEm           DateTime?       @map("enviado_em")
  aprovadoEm          DateTime?       @map("aprovado_em")
  criadoEm            DateTime        @default(now()) @map("created_at")
  atualizadoEm        DateTime        @updatedAt @map("updated_at")

  municipio        Municipio           @relation(fields: [municipioId], references: [id])
  formularioVersao FormularioVersao    @relation(fields: [formularioVersaoId], references: [id])
  competencia      Competencia         @relation(fields: [competenciaId], references: [id])
  autor            Usuario             @relation(fields: [autorId], references: [id])
  respostas        Resposta[]
  historico        RespostaHistorico[]
  anexos           AnexoSubmissao[]

  @@index([municipioId])
  @@index([competenciaId])
  @@index([formularioVersaoId])
  @@index([status])
  @@index([municipioId, competenciaId])
  @@index([municipioId, formularioVersaoId, competenciaId])
  @@map("submissoes")
}

/// Resposta normalizada: uma linha por pergunta respondida na submissao.
/// `valor` em JSON acomoda texto, numero, booleano ou lista (CHECKBOX).
model Resposta {
  id             String @id @default(cuid())
  submissaoId    String @map("submissao_id")
  perguntaId     String @map("pergunta_id")
  perguntaCodigo String @map("pergunta_codigo")
  valor          Json?

  submissao Submissao @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  pergunta  Pergunta  @relation(fields: [perguntaId], references: [id])

  @@unique([submissaoId, perguntaId])
  @@index([submissaoId])
  @@map("respostas")
}

/// Historico imutavel da submissao: uma linha por acao (envio, correcao, revisao,
/// aprovacao, edicao), com snapshot das respostas antes da alteracao.
model RespostaHistorico {
  id             String           @id @default(cuid())
  submissaoId    String           @map("submissao_id")
  autorId        String           @map("autor_id")
  acao           String
  comentario     String?
  statusAnterior SubmissaoStatus? @map("status_anterior")
  statusNovo     SubmissaoStatus? @map("status_novo")
  snapshot       Json?
  criadoEm       DateTime         @default(now()) @map("created_at")

  submissao Submissao @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  autor     Usuario   @relation(fields: [autorId], references: [id])

  @@index([submissaoId])
  @@map("respostas_historico")
}

/// Anexo de uma submissao. `perguntaCodigo` nulo = anexo geral; preenchido =
/// resposta de uma pergunta UPLOAD. Vincula um Arquivo (storage) a Submissao.
model AnexoSubmissao {
  id             String   @id @default(cuid())
  submissaoId    String   @map("submissao_id")
  arquivoId      String   @map("arquivo_id")
  perguntaCodigo String?  @map("pergunta_codigo")
  criadoEm       DateTime @default(now()) @map("created_at")

  submissao Submissao @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  arquivo   Arquivo   @relation(fields: [arquivoId], references: [id])

  @@index([submissaoId])
  @@index([arquivoId])
  @@map("anexos_submissao")
}

// ===================== PROTOCOLO / ARQUIVO / AUDITORIA =======================

/// Contador para geracao ATOMICA do protocolo por UF+ano (MG-AAAA-NNNNNNNN).
model ProtocoloSequencia {
  id           String   @id @default(cuid())
  ufSigla      String   @map("uf_sigla") // armazena Uf.sigla (ex.: "MG"), nao o codigo IBGE
  ano          Int
  ultimoNumero Int      @default(0) @map("ultimo_numero")
  atualizadoEm DateTime @updatedAt @map("updated_at")

  @@unique([ufSigla, ano])
  @@map("protocolo_sequencias")
}

/// Metadados de arquivo no storage (abstracao local | s3-compativel).
model Arquivo {
  id           String   @id @default(cuid())
  chave        String   @unique
  nomeOriginal String   @map("nome_original")
  mimeType     String?  @map("mime_type")
  tamanhoBytes Int?     @map("tamanho_bytes")
  driver       String
  criadoEm     DateTime @default(now()) @map("created_at")

  anexos AnexoSubmissao[]

  @@map("arquivos")
}

/// Log de auditoria imutavel (responsabilizacao LGPD).
model LogAuditoria {
  id         String   @id @default(cuid())
  atorId     String?  @map("ator_id")
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  antes      Json?
  depois     Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  criadoEm   DateTime @default(now()) @map("created_at")

  ator Usuario? @relation(fields: [atorId], references: [id])

  @@index([entidade, entidadeId])
  @@index([atorId])
  @@index([criadoEm])
  @@map("logs_auditoria")
}

// =================== AUTENTICACAO / LGPD =====================================

/// Termo de uso / privacidade versionado (LGPD art. 8 e 9).
/// Exibido obrigatoriamente no cadastro; o aceite fica em AceiteTermoLgpd.
model TermoLgpd {
  id       String   @id @default(cuid())
  versao   String   @unique
  conteudo String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("created_at")

  aceites AceiteTermoLgpd[]

  @@map("termos_lgpd")
}

/// Registro imutável de aceite do Termo LGPD (ROPA — art. 37 LGPD).
/// Grava: usuário, e-mail, IP, user-agent, versão do termo e data/hora.
model AceiteTermoLgpd {
  id          String   @id @default(cuid())
  usuarioId   String?  @map("usuario_id")
  email       String
  ip          String
  userAgent   String?  @map("user_agent")
  versaoTermo String   @map("versao_termo")
  aceitouEm   DateTime @default(now()) @map("aceitou_em")

  usuario Usuario?  @relation(fields: [usuarioId], references: [id])
  termo   TermoLgpd @relation(fields: [versaoTermo], references: [versao])

  @@index([email])
  @@index([versaoTermo])
  @@index([usuarioId])
  @@map("aceites_termo_lgpd")
}

/// Token de recuperação de senha (SHA-256 hash; validade 1 h; uso único).
model RecuperacaoSenha {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("recuperacao_senhas")
}
