# =============================================================================
# Configuracao do pnpm para o monorepo Defesa Civil MG.
# -----------------------------------------------------------------------------
# node-linker=hoisted: instala as dependencias como arquivos REAIS (flat) em
# node_modules, em vez do virtual store com symlinks (padrao "isolated"). Isso
# torna as imagens Docker reproduziveis e permite copiar node_modules entre
# stages sem symlinks quebradas apontando para o .pnpm da raiz.
node-linker=hoisted

# Garante que scripts de build/postinstall de dependencias confiaveis rodem
# (ex.: prisma, esbuild). Ajuste conforme a politica de seguranca da equipe.
# (pnpm >= 9 ignora build scripts por padrao sem esta lista.)
enable-pre-post-scripts=true
